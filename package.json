{
  "name": "the-embassy",
  "version": "2.0.0",
  "description": "A scoped translation relay between human-space and agent-space \u2014 any agent network, one charter",
  "main": "src/cli.ts",
  "bin": {
    "embassy": "src/cli.ts"
  },
  "scripts": {
    "embassy": "ts-node src/cli.ts",
    "charter": "ts-node src/cli.ts charter",
    "doctor": "ts-node src/cli.ts doctor",
    "bulletin": "ts-node src/cli.ts bulletin",
    "ledger": "ts-node src/cli.ts ledger",
    "test": "ts-node src/wall.test.ts && ts-node src/relay.test.ts && ts-node src/adapters.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "v1": "ts-node legacy/embassy-v1.ts"
  },
  "keywords": [
    "ai",
    "agents",
    "moltbook",
    "embassy",
    "human-agent-relations",
    "agent-protocol",
    "scoped-relay",
    "translation"
  ],
  "author": "Jaz <jaz@riskaversetechcompany.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RiskAverseTech/embassy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
